<?xml version="1.0"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="Private directories" stopProcessing="true">
                    <match url="^(?:app|config|data|libs|vendor|tests?|harness|node_modules|mcp/(?:src|vendor))(?:/|$)|(^|/)\.(?!well-known(?:/|$))" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="Private files" stopProcessing="true">
                    <match url="(?:^|/)(?:cli|composer\.(?:json|lock)|AGENTS\.md)$|\.(?:log|sql|sqlite3?|db|bak|old|orig|save|pem|key|zip|tar|gz|7z)$|^(?!index\.php$|jsonrpc\.php$|mcp/(?:index|oauth)\.php$).*\.php(?:/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
                </rule>
                <rule name="OAuth metadata" stopProcessing="true">
                    <match url="^\.well-known/oauth-authorization-server$" />
                    <action type="Rewrite" url="mcp/oauth.php?action=metadata" appendQueryString="true" />
                </rule>
                <rule name="OAuth resource metadata" stopProcessing="true">
                    <match url="^\.well-known/oauth-protected-resource(?:/mcp/?)?$" />
                    <action type="Rewrite" url="mcp/oauth.php?action=resource" appendQueryString="true" />
                </rule>
                <rule name="MCP endpoint" stopProcessing="true">
                    <match url="^mcp/?$" />
                    <action type="Rewrite" url="mcp/index.php" appendQueryString="true" />
                </rule>
                <rule name="Kanboard URL Rewrite" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
